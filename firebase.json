{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "FIREBASE_SETUP.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "comment": "The shell, the SW and the manifest must revalidate every load, or a deploy takes up to an hour to reach anyone AND the service worker can never update itself. ETags keep the revalidation cheap. Header globs match the REQUEST path, so the bare '/' needs its own rule — '/index.html' alone never matches a visit to the site root.",
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "comment": "app.js is always requested as app.js?v=<build>, so a new build is a new URL — safe to keep forever.",
        "source": "/app.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "comment": "Vendored React and icons change only when re-vendored — a week is plenty.",
        "source": "/react*.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "**/*.@(png|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
